# ============================================================
# LorePack — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# --- Google Cloud ---
# Automatically detected via `gcloud auth application-default login`,
# but can be overridden explicitly:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- GCS ---
# Bucket for generated images. Defaults to "lorepack-assets-gemini-hack".
# LOREPACK_GCS_BUCKET=lorepack-assets-gemini-hack

# --- Imagen ---
# GCP region for Imagen API calls. Defaults to "us-central1".
# IMAGEN_LOCATION=us-central1

# --- Model overrides (optional) ---
# LOREPACK_STORY_MODEL=gemini-3-flash-preview
# LOREPACK_IMAGE_MODEL=imagen-4.0-fast-generate-001
# LOREPACK_STORY_MAX_OUTPUT_TOKENS=8192
# LOREPACK_STORY_TOP_K=8

# --- Firebase Auth ---
# Path to a Firebase service account JSON file (optional — falls back to ADC).
# FIREBASE_SERVICE_ACCOUNT=path/to/service-account.json

# Bypass Firebase auth for local development (set a fixed UID):
# LOREPACK_AUTH_BYPASS_UID=local-dev-user
# LOREPACK_AUTH_BYPASS_EMAIL=dev@example.com

# --- CORS ---
# Extra allowed origins (comma-separated). localhost:5173 and 3000 are always allowed.
# ALLOWED_ORIGINS=https://my-production-domain.com

# --- A2A ---
# Base URL for A2A agent cards. Defaults to http://localhost:8000.
# A2A_BASE_URL=http://localhost:8000

# --- Agent version (shown in A2A agent card) ---
# AGENT_VERSION=0.1.0

# --- Test mode (for CI / lightweight runs) ---
# LOREPACK_TEST_MODE=false
# LOREPACK_TEST_STORY_MODEL=gemini-3-flash-preview
# LOREPACK_TEST_IMAGE_MODEL=imagen-4.0-fast-generate-001
# LOREPACK_TEST_MAX_OUTPUT_TOKENS=512
# LOREPACK_TEST_STORY_TOP_K=4
# LOREPACK_TEST_IMAGE_SIZE=
